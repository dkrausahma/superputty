<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- WiX 5 is MS-RL licensed; WiX 6+ ships under the Open Source Maintenance Fee EULA, so don't bump the major version
       without checking the license. Build: dotnet build SuperPuttyInstaller -c Release -->
  <PropertyGroup>
    <OutputName>SuperPuttySetup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuperPutty\SuperPutty.csproj" />
  </ItemGroup>

</Project>
