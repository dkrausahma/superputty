<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SuperPutty</RootNamespace>
    <AssemblyName>SuperPutty</AssemblyName>
    <StartupObject>SuperPutty.Program</StartupObject>
    <ApplicationIcon>Apps-utilities-terminal.ico</ApplicationIcon>
    <LangVersion>7.3</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Version and assembly attributes stay in Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Keep the historic output layout: <solution>\bin\<Configuration>\ -->
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Runtime.Remoting" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel.Web" />
    <Reference Include="System.Web" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Net.Http" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DockPanelSuite" Version="3.1.1" />
    <PackageReference Include="DockPanelSuite.ThemeVS2005" Version="3.1.1" />
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Designer / code generator metadata -->
  <ItemGroup>
    <!-- Explicit DependentUpon keeps the manifest resource names (SuperPutty.ApplicationPanel /
         SuperPutty.Log4netLogViewer) the old project produced; the forms load them by type name. -->
    <EmbeddedResource Update="ctlApplicationPanel.resx" DependentUpon="ctlApplicationPanel.cs" />
    <EmbeddedResource Update="Log4netDebugLogForm.resx" DependentUpon="Log4netDebugLogForm.cs" />
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Gui\QuickSelectorData.cs">
      <DependentUpon>QuickSelectorData.xsd</DependentUpon>
    </Compile>
    <Compile Update="Gui\QuickSelectorData.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>QuickSelectorData.xsd</DependentUpon>
    </Compile>
    <None Update="Gui\QuickSelectorData.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>QuickSelectorData.Designer.cs</LastGenOutput>
    </None>
    <None Update="Gui\QuickSelectorData.xsc;Gui\QuickSelectorData.xss">
      <DependentUpon>QuickSelectorData.xsd</DependentUpon>
    </None>
  </ItemGroup>

  <!-- Themes are copied next to the executable (replaces the old xcopy post-build step) -->
  <ItemGroup>
    <None Remove="Resources\themes\**" />
    <None Include="Resources\themes\**\*">
      <Link>themes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
